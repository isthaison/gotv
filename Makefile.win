CC ?= gcc
CXX ?= g++
AR ?= ar
WINDRES ?= windres
PKG_CONFIG ?= pkg-config

# Object/target tree. Overridable so the same makefile can build the 32-bit
# TSF payload (needed by 32-bit hosts such as Zalo) into a separate tree:
#   make BUILD_ROOT=build/win32 CC=/mingw32/bin/gcc ... tsf32
BUILD_ROOT ?= build

# The stable stub hardcodes the engine DLL it forwards to. The 32-bit build
# points at gtv_engine32.dll so both architectures can live side by side in
# ver\<V>\.
ENGINE_DLL_NAME ?= gtv_engine.dll

# Cross toolchain for the 32-bit payload (MSYS2 mingw32 environment).
MINGW32_PREFIX ?= /mingw32
MINGW32_CC ?= $(MINGW32_PREFIX)/bin/gcc
MINGW32_CXX ?= $(MINGW32_PREFIX)/bin/g++
MINGW32_AR ?= $(MINGW32_PREFIX)/bin/ar
MINGW32_WINDRES ?= $(MINGW32_PREFIX)/bin/windres
MINGW32_PKG_CONFIG ?= $(MINGW32_PREFIX)/bin/pkg-config
ARCH32_BUILD ?= build/win32

include mk/common.mk

CFLAGS ?= -O2 -g -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Iengine $(shell $(PKG_CONFIG) --cflags gio-2.0)
# -loleaut32: windows/keyboard.c calls SysFreeString (BSTR) for the TSF profiles.
LDFLAGS ?= $(shell $(PKG_CONFIG) --libs gio-2.0) -lm -mwindows -luser32 -lshell32 -ladvapi32 -lole32 -loleaut32 -luuid -lcomctl32

TSF_CXXFLAGS ?= -O2 -g -std=c++14 -Wall -Wextra -Wno-unused-parameter -Iengine -Iwindows/tsf $(shell $(PKG_CONFIG) --cflags gio-2.0)
# Stable stub (registered once, almost never replaced): pure Win32, not even a
# runtime DLL, so it always loads - see the note on the injected engine below.
STUB_LDFLAGS ?= -shared windows/tsf/gtv_tsf.def -lole32 -loleaut32 -luuid -ladvapi32 -luser32 -mwindows -static-libgcc -static-libstdc++
# Only stub_loader.cpp consumes this; tsf_register.cpp is shared unchanged.
STUB_CXXFLAGS ?= $(TSF_CXXFLAGS) -DGTV_ENGINE_DLL_FILE=$(ENGINE_DLL_NAME)

# --- Injected TSF engine: statically linked glib -------------------------
# gtv_engine.dll is loaded by Windows into EVERY process that takes text
# input (Word, Chrome, Teams, VS Code, ...). An injected DLL must not import
# third-party DLLs by name: the loader resolves imports by base name against
# whatever is already mapped, so a host app that ships its own copy silently
# hijacks ours. Microsoft Teams (Chromium) ships zlib1.dll exporting only the
# z_* prefixed API, so glib's "deflate" import resolved to it and the whole
# app died with "The procedure entry point deflate could not be located in
# ...libgio-2.0-0.dll".
#
# So glib/gio/zlib/intl/iconv/pcre2/libffi/libstdc++/libgcc/winpthread are all
# linked INTO the engine DLL; it then imports system DLLs only (the `test`
# target and `check-tsf-isolated` below enforce that). gotv.exe keeps
# the shared glib: it is a normal process and may ship the MSYS2 runtime.
#
# Static and shared glib disagree on the ABI (dllimport vs direct calls), so
# the engine objects are compiled into a separate tree, never shared with the
# objects that go into gotv.exe.
GLIB_STATIC_DEFS = -DGLIB_STATIC_COMPILATION -DGOBJECT_STATIC_COMPILATION \
                   -DGIO_STATIC_COMPILATION -DGMODULE_STATIC_COMPILATION
STATIC_CFLAGS ?= $(CFLAGS) $(GLIB_STATIC_DEFS)
STATIC_CXXFLAGS ?= $(TSF_CXXFLAGS) $(GLIB_STATIC_DEFS)

# -nodefaultlibs: gcc's spec would append -lpthread dynamically, which drags
# libwinpthread-1.dll back in as an import. Everything is spelled out instead;
# one --start-group keeps the mutual references between the archives resolvable.
STATIC_SYS_LIBS = -lmingw32 -lmoldname -lmingwex -lmsvcrt -lkernel32 \
                  -lole32 -loleaut32 -luuid -ladvapi32 -luser32 -lgdi32 \
                  -lpsapi -lshlwapi -lshell32 -lws2_32 -liphlpapi -ldnsapi
GLIB_STATIC_LIBS = -Wl,--start-group \
                   -Wl,-Bstatic -lgio-2.0 -lgobject-2.0 -lgmodule-2.0 -lglib-2.0 \
                   -lintl -lffi -liconv -lpcre2-8 -lz -Wl,-Bdynamic \
                   $(STATIC_SYS_LIBS) \
                   -Wl,-Bstatic -lstdc++ -lgcc -lgcc_eh -lpthread -Wl,-Bdynamic \
                   -Wl,--end-group
# MSYS2's static libglib vasnprintf.o calls wcrtomb through an import
# pointer (call *__imp_wcrtomb(%rip)); mingw-w64 has no __imp_wcrtomb data
# symbol. --defsym aliased it to the function ENTRY, so the indirect call
# executed code bytes as a pointer (0xc0000005 at the call site, crash-loop
# explorer.exe). A real data slot holding &wcrtomb is the correct fix.
GLIB_STATIC_FIXUPS = $(BUILD_ROOT)/win-static/windows/tsf/wcrtomb_slot.o

# Versioned engine DLL (real text service, lives in ver\<V>\).
TSF_ENGINE_LDFLAGS ?= -shared -nodefaultlibs windows/tsf/gtv_engine.def $(STATIC_ENGINE_OBJS) $(GLIB_STATIC_LIBS) $(GLIB_STATIC_FIXUPS) -Wl,--allow-multiple-definition -Wl,--exclude-libs,ALL -mwindows

RC_SRC = windows/resource.rc

# Release version: installer filename, Add/Remove Programs entry and the
# in-app updater compare against this. Single source is ./VERSION
# (see mk/common.mk); bump via ./gtv.sh bump, never by hand.
VERSION ?= $(GTV_VERSION)
# Inno needs a 4-part numeric version; keep VERSION as X.Y.Z for that.
VERSION_NUM ?= $(VERSION).0

ENGINE_OBJS = $(ENGINE_SRCS:%.c=$(BUILD_ROOT)/win/%.o)
WIN_OBJS = $(WIN_SRCS:%.c=$(BUILD_ROOT)/win/%.o)
TSF_STUB_OBJS = $(TSF_STUB_SRCS:%.cpp=$(BUILD_ROOT)/win/%.o)
# Separate tree for the injected engine (see GLIB_STATIC_DEFS above): the same
# C sources compiled against the static glib ABI must not be mixed with the
# shared-glib objects that end up in gotv.exe.
STATIC_ENGINE_OBJS = $(ENGINE_SRCS:%.c=$(BUILD_ROOT)/win-static/%.o)
STATIC_TSF_ENGINE_OBJS = $(TSF_ENGINE_SRCS:%.cpp=$(BUILD_ROOT)/win-static/%.o)
RC_OBJ = $(BUILD_ROOT)/win/windows/resource.o
STUB_RC_OBJ = $(BUILD_ROOT)/win/windows/stub.o
CORE_LIB = $(BUILD_ROOT)/win/libgotv.a

TARGET = $(BUILD_ROOT)/win/gotv.exe
TSF_TARGET = $(BUILD_ROOT)/win/gtv_tsf.dll
TSF_ENGINE_TARGET = $(BUILD_ROOT)/win/gtv_engine.dll
TEST_ENGINE = $(BUILD_ROOT)/win/test-engine.exe
TEST_SUPPORT = $(BUILD_ROOT)/win/test-support.exe
TEST_VERDIR = $(BUILD_ROOT)/win/test-verdir.exe

# DLLs inspected by check-tsf-isolated (overridable for the 32-bit tree).
TSF_CHECK_DLLS ?= $(TSF_TARGET) $(TSF_ENGINE_TARGET)

TEST_CFLAGS ?= -O2 -g -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Iengine $(shell $(PKG_CONFIG) --cflags gio-2.0)
TEST_LDFLAGS ?= $(shell $(PKG_CONFIG) --libs gio-2.0) -lm

all: $(TARGET) $(TSF_TARGET) $(TSF_ENGINE_TARGET)

# 32-bit TSF payload for WOW64 hosts (Zalo and 32-bit Electron/legacy apps).
# The tray stays 64-bit; only the injected DLLs are built here. Invoke with a
# separate BUILD_ROOT and the mingw32 toolchain (see ARCH32_MAKE below).
tsf32: $(TSF_TARGET) $(TSF_ENGINE_TARGET)

# Recursive invocation used by staging(): build the same TSF sources with the
# 32-bit toolchain into the parallel tree.
ARCH32_MAKE = env PATH=$(MINGW32_PREFIX)/bin:$$PATH $(MAKE) -f Makefile.win BUILD_ROOT=$(ARCH32_BUILD) \
             CC=$(MINGW32_CC) CXX=$(MINGW32_CXX) AR=$(MINGW32_AR) \
             WINDRES=$(MINGW32_WINDRES) PKG_CONFIG=$(MINGW32_PKG_CONFIG) \
             ENGINE_DLL_NAME=gtv_engine32.dll

tsf32-build:
	$(ARCH32_MAKE) tsf32

$(TARGET): $(ENGINE_OBJS) $(WIN_OBJS) $(RC_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(ENGINE_OBJS) $(WIN_OBJS) $(RC_OBJ) $(LDFLAGS) -o $@

# Stable stub: registered once, replaced only when its own version grows.
$(TSF_TARGET): $(TSF_STUB_OBJS) $(STUB_RC_OBJ) windows/tsf/gtv_tsf.def
	@mkdir -p $(dir $@)
	$(CXX) $(TSF_STUB_OBJS) $(STUB_RC_OBJ) $(STUB_LDFLAGS) -o $@

# Versioned engine: the real text service, forwarded to by the stub.
# Statically linked (no third-party DLL imports) - see GLIB_STATIC_DEFS above.
$(TSF_ENGINE_TARGET): $(STATIC_TSF_ENGINE_OBJS) $(STATIC_ENGINE_OBJS) $(GLIB_STATIC_FIXUPS) windows/tsf/gtv_engine.def
	@mkdir -p $(dir $@)
	$(CXX) $(STATIC_TSF_ENGINE_OBJS) $(TSF_ENGINE_LDFLAGS) -o $@

# Header dependency tracking (-MMD -MP emits a .d next to every .o listing the
# headers it read; -include pulls them back in). Without it make only compares
# .c/.cpp timestamps, so `gtv.sh bump` rewriting windows/version.h did NOT
# recompile anything including it: the payload folder got named 0.8.24 while the
# binary inside still reported 0.8.23, so the updater saw a phantom update on
# every run and re-installed the same stale payload.
DEPFLAGS = -MMD -MP

$(BUILD_ROOT)/win-static/windows/tsf/%.o: windows/tsf/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(STATIC_CXXFLAGS) $(DEPFLAGS) -c $< -o $@

$(BUILD_ROOT)/win-static/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(STATIC_CFLAGS) $(DEPFLAGS) -c $< -o $@

$(BUILD_ROOT)/win/windows/stub.o: windows/stub.rc
	@mkdir -p $(dir $@)
	$(WINDRES) -Iwindows $< -o $@

$(BUILD_ROOT)/win/windows/tsf/%.o: windows/tsf/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(STUB_CXXFLAGS) -c $< -o $@

$(CORE_LIB): $(ENGINE_OBJS)
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_ROOT)/win/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DEPFLAGS) -c $< -o $@

# windows/app.manifest is embedded by resource.rc but is not included from it,
# so without listing it here a manifest-only edit is silently ignored until an
# unrelated rebuild or a clean.
$(BUILD_ROOT)/win/windows/resource.o: windows/resource.rc windows/app.manifest
	@mkdir -p $(dir $@)
	$(WINDRES) -Iwindows $< -o $@

$(TEST_ENGINE): tests/test_engine.c $(CORE_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) $< $(CORE_LIB) $(TEST_LDFLAGS) -o $@

$(TEST_SUPPORT): tests/test_support.c $(CORE_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) $< $(CORE_LIB) $(TEST_LDFLAGS) -o $@

$(TEST_VERDIR): tests/test_verdir.c $(CORE_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) $< $(CORE_LIB) $(TEST_LDFLAGS) -o $@

test: $(CORE_LIB) $(TEST_ENGINE) $(TEST_SUPPORT) $(TEST_VERDIR) check-tsf-isolated
	GTV_DATA_DIR="$(CURDIR)/data" ./$(TEST_ENGINE)
	GTV_DATA_DIR="$(CURDIR)/data" ./$(TEST_SUPPORT)
	./$(TEST_VERDIR)

# Guard for the injected-DLL contract: Windows loads gtv_tsf.dll and
# gtv_engine.dll into every text-input process, and the loader binds imports by
# base name against whatever is already mapped there. Any third-party import
# is a live landmine - Microsoft Teams (Chromium) ships its own zlib1.dll that
# exports only z_deflate, and that turned glib's "deflate" import into an
# unrecoverable load failure. Keep both DLLs on system DLLs only.
TSF_SYSTEM_DLLS = advapi32 bcrypt combase crypt32 dbghelp dnsapi gdi32 gdi32full \
                  iphlpapi kernel32 msvcrt netapi32 normaliz ntdll ole32 oleaut32 \
                  powrprof psapi rpcrt4 sechost setupapi shell32 shlwapi user32 \
                  userenv version winhttp winmm wintrust ws2_32
check-tsf-isolated: $(TSF_CHECK_DLLS)
	@fail=0; \
	for dll in $(TSF_CHECK_DLLS); do \
	  while IFS= read -r dep; do \
	    low=$$(printf '%s' "$$dep" | tr 'A-Z' 'a-z'); \
	    ok=0; \
	    for sys in $(TSF_SYSTEM_DLLS); do \
	      [ "$$low" = "$$sys.dll" ] && ok=1 && break; \
	    done; \
	    if [ "$$ok" = 0 ]; then \
	      echo "  FAIL $$dll imports $$dep (must be a system DLL)"; fail=1; \
	    fi; \
	  done < <(objdump -p "$$dll" | awk '/DLL Name:/ {print $$3}'); \
	done; \
	if [ "$$fail" = 0 ]; then echo "  ok: TSF DLLs import system DLLs only"; else exit 1; fi

# Same invariant for the 32-bit payload. objdump from the 64-bit toolchain
# reads PE32 fine; the sub-make builds the DLLs with the mingw32 toolchain.
check-tsf-isolated32:
	$(ARCH32_MAKE) TSF_CHECK_DLLS="$(ARCH32_BUILD)/win/gtv_tsf.dll $(ARCH32_BUILD)/win/gtv_engine.dll" check-tsf-isolated

# Staging dir consumed by windows/installer.iss (SourceDir=release-pkg).
# New-world layout: stable root (stub + current.txt) + versioned
# payload in ver\<V>\. Updates only ever ADD a new ver dir, so running
# processes never block the installer: no forced closes, no logoff.
STAGE = release-pkg
VERDIR = $(STAGE)/ver/$(VERSION)
staging: $(TARGET) $(TSF_TARGET) $(TSF_ENGINE_TARGET) check-tsf-isolated check-tsf-isolated32
	mkdir -p $(STAGE) $(VERDIR)/data
	# Stage exactly one payload: drop other ver\<V>\ dirs left from previous
	# packages (the installer would otherwise ship stale payloads).
	for d in $(STAGE)/ver/*/; do \
	  [ "$$d" = "$(VERDIR)/" ] || rm -rf "$$d"; \
	done
	# Drop flat-layout leftovers from pre-side-by-side packages (the real
	# payload now lives under ver/<V>/; root keeps the stub only).
	rm -rf $(STAGE)/data $(STAGE)/gspawn-win64-helper*.exe $(STAGE)/lib*.dll $(STAGE)/zlib1.dll $(STAGE)/gotv.exe
	cp $(TSF_TARGET) $(STAGE)/gtv_tsf.dll
	# 32-bit twin for WOW64 hosts (Zalo): same CLSID/profile, loaded by the
	# 32-bit registry view. Its engine has a distinct name so both payloads
	# can live in the same version dir.
	cp $(ARCH32_BUILD)/win/gtv_tsf.dll $(STAGE)/gtv_tsf32.dll
	cp $(TARGET) $(TSF_ENGINE_TARGET) $(VERDIR)/
	cp $(ARCH32_BUILD)/win/gtv_engine.dll $(VERDIR)/gtv_engine32.dll
	# Older payloads forward to this basename; same binary, no second implementation.
	cp $(TARGET) $(VERDIR)/gotiengviet.exe
	changed=1; \
	while [ "$$changed" = 1 ]; do \
	  changed=0; \
	  for binary in $(VERDIR)/*.exe $(VERDIR)/*.dll; do \
	    [ -f "$$binary" ] || continue; \
	    while IFS= read -r dll; do \
	      if [ -f "/mingw64/bin/$$dll" ] && [ ! -f "$(VERDIR)/$$dll" ]; then \
	        cp "/mingw64/bin/$$dll" $(VERDIR)/; \
	        changed=1; \
	      fi; \
	    done < <(objdump -p "$$binary" | awk '/DLL Name:/ {print $$3}'); \
	  done; \
	done
	cp -f /mingw64/bin/gspawn-win64-helper*.exe $(VERDIR)/ 2>/dev/null || true
	printf '%s' "$(VERSION)" > $(STAGE)/current.txt
	cp README.md LICENSE $(STAGE)/
	cp data/macros.txt data/emojis.txt data/config data/dict-*.txt data/learned-corrections.txt data/learned-words.txt $(VERDIR)/data/

# Versioned installer (Windows-only: needs Inno Setup's iscc.exe).
# SourceDir is relative to windows/installer.iss (script dir), not to make.
setup: staging
	iscc.exe /Q "/DAppVersion=$(VERSION)" "/DAppVerNum=$(VERSION_NUM)" "/DSourceDir=..\$(STAGE)" windows/installer.iss

clean:
	rm -rf build/win build/win-static $(ARCH32_BUILD)
	rm -rf $(STAGE)

-include $(WIN_OBJS:.o=.d) $(STATIC_ENGINE_OBJS:.o=.d) \
         $(STATIC_TSF_ENGINE_OBJS:.o=.d)

.PHONY: all clean test check-tsf-isolated check-tsf-isolated32 tsf32 tsf32-build
