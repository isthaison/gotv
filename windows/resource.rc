#include <windows.h>
#include <commctrl.h>
#include "resource.h"

/* The dialog strings below are UTF-8: tell windres (and rc.exe) to read
 * this file as UTF-8, otherwise Vietnamese text becomes mojibake when
 * the build machine uses another system codepage. */
#pragma code_page(65001)

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

/* Visual Styles (themed controls), asInvoker, DPI-aware. */
1 RT_MANIFEST "app.manifest"

IDI_APP_ICON    ICON    "icons/gotv.ico"

IDD_SETUP_DIALOG DIALOGEX 0, 0, 240, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTV - Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ASCII placeholders only: the real (Vietnamese) strings are set at
     * runtime in UTF-16, so no resource compiler codepage can mojibake
     * this dialog on any build machine or system locale. */
    GROUPBOX        "Input method", IDC_GROUP_TYPE, 10, 10, 220, 45
    AUTORADIOBUTTON "Telex", IDC_RADIO_TELEX, 20, 24, 190, 10, WS_GROUP
    AUTORADIOBUTTON "VNI", IDC_RADIO_VNI, 20, 38, 190, 10

    GROUPBOX        "Options", IDC_GROUP_OPTS, 10, 60, 220, 65
    AUTOCHECKBOX    "New tone-mark placement", IDC_CHECK_MODERN, 20, 74, 200, 10
    AUTOCHECKBOX    "Spellcheck and smart suggestions", IDC_CHECK_SPELL, 20, 90, 200, 10
    AUTOCHECKBOX    "Start with Windows", IDC_CHECK_STARTUP, 20, 106, 200, 10

    GROUPBOX        "Dictionary suggestions (offline)", IDC_GROUP_DICT, 10, 130, 220, 92
    AUTOCHECKBOX    "Enable smart suggestions", IDC_CHECK_SUGGEST, 20, 144, 200, 10
    AUTOCHECKBOX    "Vietnamese", IDC_CHECK_DICT_VI, 20, 158, 62, 10
    AUTOCHECKBOX    "T-SQL", IDC_CHECK_DICT_TSQL, 86, 158, 52, 10
    AUTOCHECKBOX    "C / C++", IDC_CHECK_DICT_C, 142, 158, 78, 10
    AUTOCHECKBOX    "C# (.NET)", IDC_CHECK_DICT_CSHARP, 20, 172, 62, 10
    AUTOCHECKBOX    "English", IDC_CHECK_DICT_EN, 86, 172, 70, 10
    LTEXT           "Dict:", IDC_LBL_DICT_VER, 20, 188, 140, 10
    PUSHBUTTON      "Update", IDC_BTN_DICT_UPDATE, 165, 186, 55, 14
    LTEXT           "Status", IDC_LBL_DICT_STATUS, 20, 204, 200, 10

    DEFPUSHBUTTON   "OK", IDC_BTN_OK, 126, 234, 50, 14
    PUSHBUTTON      "Cancel", IDC_BTN_CANCEL, 179, 234, 50, 14
    PUSHBUTTON      "Data", IDC_BTN_DATA, 5, 234, 55, 14
    PUSHBUTTON      "Keyboards", IDC_BTN_KEYBOARD, 63, 234, 60, 14
END

IDD_DATA_DIALOG DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTV - Data"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ASCII placeholders only: real strings are set at runtime in UTF-16. */
    AUTORADIOBUTTON "Macro", IDC_DATA_MACRO, 10, 10, 120, 10, WS_GROUP
    AUTORADIOBUTTON "Emoji", IDC_DATA_EMOJI, 135, 10, 120, 10
    CONTROL         "", IDC_DATA_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,
                    10, 25, 260, 100
    LTEXT           "Key:", IDC_LBL_KEY, 10, 132, 40, 10
    EDITTEXT        IDC_DATA_KEY, 55, 130, 215, 12
    LTEXT           "Value:", IDC_LBL_VALUE, 10, 147, 40, 10
    EDITTEXT        IDC_DATA_VALUE, 55, 145, 215, 12
    PUSHBUTTON      "Save", IDC_DATA_SAVE, 10, 165, 60, 14
    PUSHBUTTON      "Delete", IDC_DATA_DELETE, 75, 165, 60, 14
    PUSHBUTTON      "Folder", IDC_DATA_FOLDER, 140, 165, 65, 14
    PUSHBUTTON      "Close", IDC_DATA_CLOSE, 210, 165, 60, 14
    LTEXT           "Note", IDC_DATA_NOTE, 10, 188, 260, 36
END

/* Keyboard manager. The list order IS the Win+Space order, so the buttons
 * next to it move an entry up/down in that order. */
IDD_KEYBOARD_DIALOG DIALOGEX 0, 0, 290, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTV - Keyboards"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ASCII placeholders only: real strings are set at runtime in UTF-16. */
    LTEXT           "Current", IDC_KBD_LBL_CURRENT, 8, 8, 200, 10
    CONTROL         "", IDC_KBD_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,
                    8, 20, 210, 120
    PUSHBUTTON      "Up", IDC_KBD_UP, 226, 20, 56, 14
    PUSHBUTTON      "Down", IDC_KBD_DOWN, 226, 38, 56, 14
    PUSHBUTTON      "Remove", IDC_KBD_REMOVE, 226, 56, 56, 14
    PUSHBUTTON      "Add", IDC_KBD_ADD, 226, 80, 56, 14
    PUSHBUTTON      "Default", IDC_KBD_DEFAULT, 226, 98, 56, 14
    LTEXT           "Status", IDC_KBD_STATUS, 8, 146, 274, 20
    PUSHBUTTON      "Close", IDC_KBD_CLOSE, 222, 178, 60, 14
END

/* "Add keyboard" picker: language on top, that language's keyboards below. */
IDD_KBD_ADD_DIALOG DIALOGEX 0, 0, 250, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTV - Add keyboard"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    COMBOBOX        IDC_KBD_LANG, 8, 8, 234, 200,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_KBD_AVAIL, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,
                    8, 32, 234, 140
    DEFPUSHBUTTON   "Add", IDC_KBD_AVAIL_ADD, 100, 178, 66, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 172, 178, 66, 14
END

1 VERSIONINFO
FILEVERSION     0,9,3,0
PRODUCTVERSION  0,9,3,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GoTV Open Source Project\0"
            VALUE "FileDescription", "GoTV - Vietnamese Input (Native)\0"
            VALUE "FileVersion", "0.9.3.0\0"
            VALUE "InternalName", "gotv\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "gotv.exe\0"
            VALUE "ProductName", "GoTV\0"
            VALUE "ProductVersion", "0.9.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
