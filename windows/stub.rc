#include <windows.h>

/* Stub version: bump by 1 whenever windows/tsf/stub_loader.cpp or
 * windows/tsf/tsf_register.cpp change.
 *
 * It MUST be strictly increasing. The installer's gtv_tsf.dll entry has no
 * ignoreversion flag (windows/installer.iss), so Inno compares VERSIONINFO
 * and replaces the stub ONLY when the staged version is NEWER. A version
 * that goes backwards is never installed: the machine keeps the old stub
 * forever and every later stub fix is silently dropped.
 *
 * Deliberately independent from the app GTV_VERSION. */
#define GTV_STUB_VERSION "3"
#define GTV_STUB_VERSION_NUM 3,0,0,0

1 VERSIONINFO
FILEVERSION     GTV_STUB_VERSION_NUM
PRODUCTVERSION  GTV_STUB_VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GoTV Open Source Project\0"
            VALUE "FileDescription", "GoTV TSF stub (stable)\0"
            VALUE "FileVersion", GTV_STUB_VERSION ".0\0"
            VALUE "InternalName", "gtv_tsf\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "gtv_tsf.dll\0"
            VALUE "ProductName", "GoTV\0"
            VALUE "ProductVersion", GTV_STUB_VERSION ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
